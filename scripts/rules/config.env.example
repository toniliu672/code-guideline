# ==============================================================================
# CODE GUIDELINES & RULES AUDIT CONFIGURATION (config.env / .guidelines.env)
# ==============================================================================
# Copy to 'scripts/rules/config.env' (global) or '.guidelines.env' (per-project, commit to Git).

# 1. Project & Core Rules
PROJECT_NAME=""
ENABLE_CORE=true
MAX_LINES=100
MAX_LAYOUT_LINES=250
STRICT_LINES=true
LINE_EXCLUDES="database/migrations|database/seeders|config/"
CODE_DIRS="app src lib routes components pages"

# 2. Syntax & Static Analysis
# LINTER_TOOL: auto | php-laravel | js-ts | svelte | flutter | syntax-only | none
LINTER_TOOL="auto"
CHECK_SYNTAX=true
CHECK_STATIC_ANALYSIS=true

# 3. Frontend & Blade Rules
# FRONTEND_APPROACH: auto | blade | react | next | svelte | flutter | none
# BLADE_APPROACH:    auto | standard | admin-separated | atomic
# STRICTNESS_LEVEL:  standard | moderate | strict
FRONTEND_APPROACH="auto"
VIEWS_DIR="resources/views"
BLADE_APPROACH="auto"
STRICTNESS_LEVEL="standard"
BLADE_RAW_TAGS=""
MAX_BLADE_PHP_LINES=3

# 4. Design System & Tailwind Rules
CHECK_COLOR_TOKENS=true
CHECK_TRAIN_TRACK=true
CHECK_CLASS_CONFLICTS=true
CHECK_CANONICAL_CLASSES=true
MAX_CLASS_CHARS=100
MAX_CLASS_WORDS=10

# 5. System Architecture Paradigm
# ARCHITECTURE_APPROACH: auto | mvc | service-layer | modular | microservices | none
ARCHITECTURE_APPROACH="auto"

# 6. Automated Testing
# TEST_SUITES (comma-separated): laravel, pest, phpunit, frontend, vitest, jest, flutter, k6, none
ENABLE_TESTING=false
RUN_AUTOMATED_TESTS=true
TEST_SUITES="laravel,k6"

# 7. Security (ISO 27001 / 27701 / 25010) & CLI
ENABLE_SECURITY=true
CHECK_DEBUG_STATEMENTS=true
USE_RTK="auto"

# 8. Universal Runtime & Browser Error Guard (guidelines runtime / crawl)
ENABLE_RUNTIME_GUARD=false
RUNTIME_BASE_URL=""
RUNTIME_CONFIG=".guidelines.runtime.json"
RUNTIME_ROUTES="/"
RUNTIME_FAIL_ON_4XX=false
RUNTIME_FAIL_ON_CONSOLE_ERROR=true
RUNTIME_LOG_FILE=""
RUNTIME_MAX_PAGES=50
RUNTIME_TIMEOUT_MS=15000
