# ==============================================================================
# CODE GUIDELINES & RULES AUDIT CONFIGURATION (config.env)
# ==============================================================================
# Copy this file to 'config.env' in 'scripts/rules/' to customize your project rules.

# 1. Project Identifier (Auto-detected from working directory name if empty)
PROJECT_NAME=""

# 2. Universal Core Rules (Zero Inline Comments, Maximum Lines, Syntax & Lint)
ENABLE_CORE=true
MAX_LINES=100
MAX_LAYOUT_LINES=250
LINE_EXCLUDES="database/migrations|database/seeders|config/"
STRICT_LINES=false
CHECK_SYNTAX=true
CHECK_STATIC_ANALYSIS=true
CODE_DIRS="app src lib routes database components pages"

# 3. Frontend Paradigm Selection
# Options:
#   "auto"    : Automatically detects the frontend framework used in the project
#   "blade"   : Component-Based Architecture for Laravel Blade
#   "react"   : Component-Based Architecture for React
#   "next"    : Component-Based Architecture for Next.js (App / Pages router)
#   "svelte"  : Component-Based Architecture for Svelte / SvelteKit ($lib/components)
#   "flutter" : Custom Widget Modularization for Flutter (lib/widgets)
#   "none"    : Disables frontend checks (e.g. pure backend API project)
FRONTEND_APPROACH="auto"

# Blade Component & Layout Approach (when FRONTEND_APPROACH is blade or auto):
# Options:
#   "standard" : Standard folder-based components & layouts (resources/views/components/**,
#                components/admin/**, layouts/**). Page views compose <x-...> tags. (Default)
#   "atomic"   : Strict Brad Frost Atomic Design (components/atoms/**, components/layouts/**).
BLADE_APPROACH="standard"
BLADE_RAW_TAGS="input|select|textarea|button"

# 4. Design System & Styling Rules (Colors, Conflicts, & Canonical Classes)
CHECK_COLOR_TOKENS=true
CHECK_TRAIN_TRACK=true
CHECK_CLASS_CONFLICTS=true
CHECK_CANONICAL_CLASSES=true
MAX_CLASS_CHARS=100
MAX_CLASS_WORDS=10

# 5. System Architecture Paradigm Selection
# Options:
#   "auto"          : Automatically detects the architecture pattern
#   "mvc"           : Model-View-Controller (Thin Controllers, Views free of queries)
#   "modular"       : Modular / Feature-Driven Architecture (Domain boundaries)
#   "service-layer" : Service Layer Architecture (Thin Controllers, Service logic)
#   "microservices" : Microservices Hygiene (Dockerfile, Health check /healthz)
#   "none"          : Disables architecture checks
ARCHITECTURE_APPROACH="auto"

# 6. Security & Data Privacy Standards
ENABLE_SECURITY=true
CHECK_DEBUG_STATEMENTS=true
